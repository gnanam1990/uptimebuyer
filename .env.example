# UptimeBuyer runtime variables (M14). Values here are placeholders. Secrets are FILES: every *_FILE / *_ROOT variable
# names a path (a container secret mount, 0600 or 0400); no variable ever holds a key, token or password.
# See infra/deploy/DEPLOYMENT.md.

# --- Local development and integration tests ----------------------------------------------------------------------
# Isolated local database for development and integration tests. Never point this at production.
DATABASE_URL=postgres://uptimebuyer:uptimebuyer@localhost:55432/uptimebuyer_dev
# In deployments DATABASE_URL carries no password; it is read from a 0600 pgpass file:
# PGPASSFILE=/run/secrets/pgpass

# --- apps/api ---------------------------------------------------------------------------------------------------------
UB_API_HOST=127.0.0.1
UB_API_PORT=8080
# OIDC identity provider: https (plain http only on loopback), public DNS names only.
UB_OIDC_ISSUER=https://idp.example.com/
UB_OIDC_AUDIENCE=uptimebuyer
UB_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
UB_OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.com/authorize
UB_OIDC_TOKEN_ENDPOINT=https://idp.example.com/oauth/token
UB_OIDC_CLIENT_ID=uptimebuyer-web
UB_OIDC_SCOPE=openid
UB_OIDC_ALGORITHMS=ES256
UB_ENVIRONMENT_LABEL=
UB_WEB_ROOT=/app/apps/web/dist
UB_OBJECT_STORE_ROOT=/var/lib/uptimebuyer/objects
# Set to true (or a proxy list) only behind a trusted reverse proxy; otherwise every client shares one source address.
UB_TRUST_PROXY=false
# Secret references (required): Ed25519 authority signer and the webhook verifier store.
UB_AUTHORITY_SIGNER_KEY_ID=authority-k1
UB_AUTHORITY_SIGNER_KEY_FILE=/run/secrets/authority_signer_key
UB_WEBHOOK_VERIFIER_ROOT=/run/ub-secrets/webhook-verifiers
# Kite session activation through the broker's unix socket (optional); requires the execution-reference signer.
UB_KITE_BROKER_SOCKET=/run/ub-broker/broker.sock
UB_REFERENCE_SIGNER_KEY_ID=reference-k1
UB_REFERENCE_SIGNER_KEY_FILE=/run/secrets/reference_signer_key
# Operations listener (metrics/alerts): private interface only, token from a 0600 file.
UB_OPS_HOST=127.0.0.1
UB_OPS_PORT=9464
UB_OPS_TOKEN_FILE=/run/secrets/api_ops_token

# --- apps/worker ------------------------------------------------------------------------------------------------------
UB_WORKER_ID=worker-1
UB_WORKER_OPS_HOST=127.0.0.1
UB_WORKER_OPS_PORT=9465
UB_WORKER_OPS_TOKEN_FILE=/run/secrets/worker_ops_token
UB_WORKER_DRAIN_TIMEOUT_MS=30000
UB_WORKER_DB_POOL_MAX=10
# Optional CMMS adapter (without both, CMMS writes are UNSUPPORTED and nothing is written).
# UB_CMMS_BASE_URL=https://cmms.example.com/
# UB_CMMS_TOKEN_FILE=/run/secrets/cmms_token
# Optional unpaid provider credential root (without it, contact attempts are UNSUPPORTED: ADAPTER_NOT_CONFIGURED).
# UB_PROVIDER_SECRET_ROOT=/run/ub-secrets/providers

# --- apps/sensor-gateway ----------------------------------------------------------------------------------------------
UB_GATEWAY_HOST=127.0.0.1
UB_GATEWAY_PORT=8081
UB_DEVICE_SECRET_ROOT=/run/ub-secrets/devices
UB_GATEWAY_SWEEP_MS=15000

# --- apps/kite-broker -------------------------------------------------------------------------------------------------
# The broker takes NO environment variable: its secret document (database URL, verification keys, the paid-endpoint
# credential reference) arrives on an inherited file descriptor from a secret mounted into the broker container only.
