{
  "name": "uptimebuyer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @uptimebuyer/web run test:e2e",
    "build": "tsc -b --pretty false && pnpm -r --if-present run build:app",
    "check:pack": "node docs/spec/scripts/check-build-pack.mjs --root docs/spec --config config/pack-check.json",
    "secrets:scan": "node scripts/secret-scan.mjs --history",
    "security:check": "node scripts/migration-lint.mjs && node scripts/deps-check.mjs",
    "coverage:report": "node scripts/coverage-report.mjs",
    "intake": "node scripts/intake.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "bootstrap": "node scripts/bootstrap.mjs",
    "verify": "pnpm lint && pnpm security:check && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:e2e && pnpm check:pack && pnpm release:check && pnpm secrets:scan",
    "release:smoke": "node scripts/release/smoke.mjs --record",
    "release:check": "node scripts/release/claim-check.mjs",
    "release:gates": "node scripts/release/release-gate.mjs status",
    "release:journey": "node scripts/release/journey-gate.mjs",
    "demo:local": "pnpm --filter @uptimebuyer/web exec playwright test -c playwright.demo.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
